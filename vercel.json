{
  "installCommand": "npm --prefix front install",
  "buildCommand": "npm --prefix front run build",
  "outputDirectory": "front/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
